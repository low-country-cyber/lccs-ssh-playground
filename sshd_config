Port 22
ListenAddress 0.0.0.0
HostKey /lab-server/ssh_host_ed25519_key
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey
AllowUsers learner automation
AllowAgentForwarding no
AllowTcpForwarding no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no
LogLevel VERBOSE
Subsystem sftp internal-sftp

# Challenges 06 and 07: the learner may reach the private demo page and use
# this server as a jump host to the hidden target, but no other destinations.
# The automation account keeps the global forwarding ban above.
Match User learner
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:8080 hidden-target:22
