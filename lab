#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
cd "$project_dir"

usage() {
  cat <<'EOF'
Usage: ./lab COMMAND

Commands:
  console              Open an SSH shell as the learner account
  automation [COMMAND] Run a command as the automation account
  report [COMMAND]     Request a command with the report-only key (fixed output)
  doctor               Check SSH identities and n8n health
  credential-info      Show the fields for all n8n SSH credentials
  import-credential    Import automation credentials after owner setup
  setup-n8n            Import credentials and all bundled workflows
  ssh-config           Print a project-local SSH config for Challenge 04
  jump-config          Print the hidden-target stanza for Challenge 07
  status               Show Compose service status
EOF
}

ssh_options=(
  -p 2222
  -o BatchMode=yes
  -o IdentitiesOnly=yes
  -o StrictHostKeyChecking=yes
  -o UserKnownHostsFile=./state/known_hosts
)

case "${1:-}" in
  console)
    shift
    exec ssh "${ssh_options[@]}" -i "$project_dir/state/keys/console" learner@127.0.0.1 "$@"
    ;;
  automation)
    shift
    exec ssh "${ssh_options[@]}" -i "$project_dir/state/keys/automation" automation@127.0.0.1 "$@"
    ;;
  report)
    shift
    if [[ $# -eq 0 ]]; then
      set -- whoami
    fi
    exec ssh "${ssh_options[@]}" -i "$project_dir/state/keys/report-only" automation@127.0.0.1 "$@"
    ;;
  doctor)
    command -v ssh >/dev/null || { echo 'OpenSSH client is required.' >&2; exit 1; }
    command -v curl >/dev/null || { echo 'curl is required for the health check.' >&2; exit 1; }
    if [[ ! -s state/keys/console || ! -s state/keys/automation || ! -s state/keys/hidden-automation || ! -s state/keys/report-only || ! -s state/known_hosts || ! -s state/hidden_known_hosts ]]; then
      echo 'Generated SSH state is missing. Run docker compose up -d.' >&2
      exit 1
    fi
    ./lab console 'whoami && hostname'
    ./lab automation 'whoami && hostname'
    report_output=$(./lab report 'whoami')
    if [[ "$report_output" != *'LCCS SSH Playground: restricted report'* ]]; then
      echo 'The report-only key did not return its fixed report.' >&2
      exit 1
    fi
    echo 'Restricted report key passed.'
    n8n_ready=false
    for ((attempt=1; attempt<=30; attempt++)); do
      if curl --fail --silent http://127.0.0.1:5680/healthz >/dev/null; then
        n8n_ready=true
        break
      fi
      sleep 2
    done
    if [[ "$n8n_ready" != true ]]; then
      echo 'n8n did not become healthy. Run docker compose logs n8n.' >&2
      exit 1
    fi
    echo 'SSH identities and n8n health passed.'
    ;;
  credential-info)
    cat <<EOF
n8n URL: http://localhost:5680

SSH Playground Automation (first target)
Type:        SSH Private Key
Host:        ssh-target
Port:        22
Username:    automation
Private key: $project_dir/state/keys/automation (read locally; do not publish)
Passphrase:  blank

SSH Playground Hidden Automation (hidden target)
Type:        SSH Private Key
Host:        hidden-target
Port:        22
Username:    automation
Private key: $project_dir/state/keys/hidden-automation (read locally; do not publish)
Passphrase:  blank

SSH Playground Report Only (first target; fixed report, no forwarding)
Type:        SSH Private Key
Host:        ssh-target
Port:        22
Username:    automation
Private key: $project_dir/state/keys/report-only (read locally; do not publish)
Passphrase:  blank
EOF
    ;;
  import-credential)
    python3 "$project_dir/scripts/import-credential.py"
    ;;
  setup-n8n)
    python3 "$project_dir/scripts/setup-n8n.py"
    ;;
  ssh-config)
    cat <<EOF
# Low Country Cyber Solutions SSH Playground: project-local client settings.
Host playground
    HostName 127.0.0.1
    User learner
    Port 2222
    IdentityFile "$project_dir/state/keys/console"
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile "$project_dir/state/known_hosts"
    ForwardAgent no
EOF
    ;;
  jump-config)
    cat <<EOF
# Low Country Cyber Solutions SSH Playground: reach the hidden target through playground.
Host hidden-lab
    HostName hidden-target
    User learner
    Port 22
    IdentityFile "$project_dir/state/keys/console"
    IdentitiesOnly yes
    StrictHostKeyChecking yes
    UserKnownHostsFile "$project_dir/state/hidden_known_hosts"
    HostKeyAlias hidden-lab
    ProxyJump playground
    ForwardAgent no
EOF
    ;;
  status)
    docker compose ps
    ;;
  *) usage; exit 2 ;;
esac
